<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CheckPo Third-Party Licenses</title>
  <style>
    body { font-family: sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { border: 1px solid #999; max-height: 24rem; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <main>
    <h1>CheckPo Third-Party Licenses</h1>
    <p>This document contains the license notices for Rust crates included in CheckPo.</p>
    <h2>License overview</h2>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>
    <h2>License texts</h2>
    {{#each licenses}}
    <section>
      {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
      <h4 id="{{id}}-{{@index}}">Used by</h4>
      <ul>
        {{#each used_by}}
        <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
